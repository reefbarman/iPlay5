+/**
+ * iPlay5: set SO_RCVBUF as large as the kernel allows, from TAKION_SO_RCVBUF_SIZE down,
+ * falling back to the original a_rwnd size. Returns setsockopt's result.
+ */
+static int takion_set_rcvbuf(ChiakiTakion *takion)
+{
+	for(int size = TAKION_SO_RCVBUF_SIZE; size > (int)takion->a_rwnd; size /= 2)
+	{
+		if(setsockopt(takion->sock, SOL_SOCKET, SO_RCVBUF, (const CHIAKI_SOCKET_BUF_TYPE)&size, sizeof(size)) == 0)
+		{
+			CHIAKI_LOGI(takion->log, "Takion receive buffer set to %d bytes", size);
+			return 0;
+		}
+	}
+	const int rcvbuf_val = takion->a_rwnd;
+	return setsockopt(takion->sock, SOL_SOCKET, SO_RCVBUF, (const CHIAKI_SOCKET_BUF_TYPE)&rcvbuf_val, sizeof(rcvbuf_val));
+}
