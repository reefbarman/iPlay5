 /**
+ * iPlay5: a video packet arrived. If it's one we already gave up on, the wait was too
+ * short: raise it to what this packet needed (plus a margin), up to the cap. Packets far
+ * later than the cap were effectively lost, so they're counted but don't raise it.
+ */
+static void takion_av_reorder_note_arrival(ChiakiTakion *takion, uint16_t seq_num)
+{
+	if(!takion->av_skip_valid)
+		return;
+	if(chiaki_seq_num_16_lt(seq_num, takion->av_skip_begin) || !chiaki_seq_num_16_lt(seq_num, takion->av_skip_end))
+		return;
+	int64_t now = chiaki_time_now_monotonic_us();
+	takion->av_packets_late++;
+	int64_t needed_us = now - takion->av_skip_wait_start_us + TAKION_AV_REORDER_LATE_MARGIN_US;
+	if(needed_us > 2 * TAKION_AV_REORDER_TIMEOUT_MAX_US)
+		return;
+	takion->av_last_late_us = now;
+	if(needed_us > TAKION_AV_REORDER_TIMEOUT_MAX_US)
+		needed_us = TAKION_AV_REORDER_TIMEOUT_MAX_US;
+	if(needed_us > takion->av_reorder_timeout_us)
+	{
+		CHIAKI_LOGI(takion->log, "Takion AV packet arrived %lld us after we gave up on it, waiting up to %lld us now",
+			(long long)(now - takion->av_skip_wait_start_us - takion->av_reorder_timeout_us), (long long)needed_us);
+		takion->av_reorder_timeout_us = needed_us;
+	}
+}
+
+/** iPlay5: once nothing has arrived late for a while, ease the wait back down. */
+static void takion_av_reorder_decay(ChiakiTakion *takion, int64_t now)
+{
+	if(takion->av_reorder_timeout_us <= TAKION_AV_REORDER_TIMEOUT_US)
+		return;
+	if(now - takion->av_last_late_us < TAKION_AV_REORDER_CALM_US
+		|| now - takion->av_last_decay_us < TAKION_AV_REORDER_DECAY_INTERVAL_US)
+		return;
+	takion->av_last_decay_us = now;
+	takion->av_reorder_timeout_us -= TAKION_AV_REORDER_DECAY_STEP_US;
+	if(takion->av_reorder_timeout_us <= TAKION_AV_REORDER_TIMEOUT_US)
+	{
+		takion->av_reorder_timeout_us = TAKION_AV_REORDER_TIMEOUT_US;
+		CHIAKI_LOGI(takion->log, "Takion AV reorder wait back to %d us", TAKION_AV_REORDER_TIMEOUT_US);
+	}
+}
