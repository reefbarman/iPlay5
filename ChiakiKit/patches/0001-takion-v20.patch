+/*
+ * iPlay5 experimental Takion v20, ported from P5M (github.com/beecrepaldi-afk/P5M-mac, mac/TAKION-V20.md).
+ *
+ * The official app negotiates the version on the stream connection after the Takion connect
+ * and before the BIG. We offer 12 and 20; the console picks. Without an answer, or with any
+ * other answer, the stream goes on with 12 exactly as before.
+ */
+typedef struct
+{
+	uint32_t items[2];
+	size_t num;
+} TakionVersions;
+
+static bool encode_takion_versions(pb_ostream_t *ostream, const pb_field_t *field, void *const *arg)
+{
+	const TakionVersions *versions = *arg;
+	for(size_t i = 0; i < versions->num; i++)
+		if(!pb_encode_tag_for_field(ostream, field) || !pb_encode_varint(ostream, versions->items[i]))
+			return false;
+	return true;
+}
+
+// Called with state_mutex held, from the takion thread.
+static void stream_connection_takion_data_expect_protocol_ack(ChiakiStreamConnection *stream_connection, uint8_t *buf, size_t buf_size)
+{
+	tkproto_TakionMessage msg;
+	memset(&msg, 0, sizeof(msg));
+	pb_istream_t stream = pb_istream_from_buffer(buf, buf_size);
+	if(!pb_decode(&stream, tkproto_TakionMessage_fields, &msg))
+	{
+		CHIAKI_LOGE(stream_connection->log, "[takion-v20] could not decode a message (%zu bytes)", buf_size);
+		return;
+	}
+	if(msg.type == tkproto_TakionMessage_PayloadType_TAKIONPROTOCOLREQUESTACK)
+	{
+		stream_connection->takion_version_ack = msg.has_takion_protocol_request_ack && msg.takion_protocol_request_ack.has_takion_protocol_version;
+		stream_connection->takion_version_acked = msg.takion_protocol_request_ack.takion_protocol_version;
+		stream_connection->state_finished = true;
+		chiaki_cond_signal(&stream_connection->state_cond);
+		return;
+	}
+	if(msg.type == tkproto_TakionMessage_PayloadType_DISCONNECT)
+	{
+		stream_connection_takion_data_handle_disconnect(stream_connection, buf, buf_size);
+		return;
+	}
+	CHIAKI_LOGW(stream_connection->log, "[takion-v20] ignoring message type %d while waiting for the version answer", msg.type);
+}
+
+// Called with state_mutex held, after the takion connect and before the BIG.
+static void stream_connection_negotiate_takion_v20(ChiakiStreamConnection *stream_connection)
+{
+	TakionVersions versions = { .items = { 12, 20 }, .num = 2 };
+	tkproto_TakionMessage msg;
+	memset(&msg, 0, sizeof(msg));
+	msg.type = tkproto_TakionMessage_PayloadType_TAKIONPROTOCOLREQUEST;
+	msg.has_takion_protocol_request = true;
+	msg.takion_protocol_request.supported_takion_versions.arg = &versions;
+	msg.takion_protocol_request.supported_takion_versions.funcs.encode = encode_takion_versions;
+
+	uint8_t buf[64];
+	pb_ostream_t stream = pb_ostream_from_buffer(buf, sizeof(buf));
+	if(!pb_encode(&stream, tkproto_TakionMessage_fields, &msg))
+	{
+		CHIAKI_LOGE(stream_connection->log, "[takion-v20] request encoding failed, staying on %u", (unsigned)stream_connection->takion.version);
+		return;
+	}
+
+	stream_connection->state = STATE_EXPECT_PROTOCOL_ACK;
+	stream_connection->state_finished = false;
+	stream_connection->state_failed = false;
+	stream_connection->takion_version_ack = false;
+	stream_connection->takion_version_acked = 0;
+	CHIAKI_LOGI(stream_connection->log, "[takion-v20] offering Takion versions 12 and 20");
+	ChiakiErrorCode err = chiaki_takion_send_message_data(&stream_connection->takion, 1, 1, buf, stream.bytes_written, NULL);
+	if(err != CHIAKI_ERR_SUCCESS)
+	{
+		CHIAKI_LOGE(stream_connection->log, "[takion-v20] sending the request failed: %s, staying on %u", chiaki_error_string(err), (unsigned)stream_connection->takion.version);
+		return;
+	}
+	chiaki_cond_timedwait_pred(&stream_connection->state_cond, &stream_connection->state_mutex, TAKION_VERSION_TIMEOUT_MS, state_finished_cond_check, stream_connection);
+	stream_connection->state_finished = false;
+	stream_connection->state_failed = false;
+
